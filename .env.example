# Pinned CUDA for faster-whisper / CTranslate2 on the Windows build machine.
# Copy to .env and set CUDA_PATH to the ONE toolkit you want loaded.
# Other CUDA installs stay on the machine but are removed from PATH for
# this process, so Windows does not pick cublas/cudnn from two places.
#
# Must match the torch wheel EnsureDeps installed (cu124 -> 12.4).

CUDA_VERSION=12.4
CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.4
